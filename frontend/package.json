{
  "name": "robotworld",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "productName": "RobotWorld",
  "description": "Autonomous world-building and curriculum engine for physical AI",
  "author": "RobotWorld",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "concurrently -k \"npm:dev\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "dev:api": "..\\backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir ..\\backend --host 127.0.0.1 --port 8000",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:backend": "..\\backend\\.venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean --distpath ..\\backend\\dist --workpath ..\\backend\\build ..\\backend\\robotworld-api.spec",
    "dist": "npm run build && npm run build:backend && electron-builder"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.4.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.robotworld.app",
    "productName": "RobotWorld",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/robotworld-api",
        "to": "backend"
      },
      {
        "from": "dist",
        "to": "frontend"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
