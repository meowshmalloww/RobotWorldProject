# Bootstrap settings. Values saved in the RobotWorld Settings UI take precedence.
HOST=127.0.0.1
PORT=8000

# Allowlisted local model/code roots. Use semicolon-separated Windows paths.
ROBOTWORLD_MODEL_ROOTS=
TRELLIS2_REPO_PATH=
TRELLIS2_CHECKPOINT_PATH=
DINOV3_REPO_PATH=
DINOV3_WEIGHTS_PATH=
LEROBOT_REPO_PATH=
VLA_JEPA_CHECKPOINT_PATH=
ROBOT_ASSET_ROOT=
# Additional semicolon-separated import roots for immutable source GLBs.
ROBOTWORLD_ASSET_IMPORT_ROOTS=
# Reject oversized/unexpected local GLBs before parsing (default 500 MiB).
ROBOTWORLD_MAX_GLB_BYTES=524288000

# Isolated VLA-JEPA worker. This Python environment must contain the explicitly
# configured LeRobot source and its pinned VLA-JEPA dependencies.
VLA_JEPA_PYTHON=
VLA_JEPA_LOAD_TIMEOUT_S=900
# Keep false unless the user explicitly authorizes model/config downloads.
ROBOTWORLD_ALLOW_MODEL_DOWNLOADS=false

# OpenAI-compatible planner (OpenAI, Ollama, vLLM, llama.cpp)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Real learned robot policy gateway selected for the exact robot embodiment
POLICY_ENDPOINT=
POLICY_API_KEY=
POLICY_MODEL_REVISION=
POLICY_MODEL_SHA256=
POLICY_NORMALIZATION_SHA256=
POLICY_ENVIRONMENT_SHA256=

# Real Microsoft TRELLIS.2 image-to-GLB gateway
TRELLIS_ENDPOINT=
TRELLIS_API_KEY=

# Bright Data (server-side bearer token; never expose through VITE_* variables)
BRIGHTDATA_API_TOKEN=
# Backward-compatible legacy alias, used only when BRIGHTDATA_API_TOKEN is empty.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ACCOUNT_ID=
BRIGHTDATA_SERP_ZONE=serp
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker

# Self-hosted SigNoz Community. OTLP ingestion is keyless by default.
SIGNOZ_ENDPOINT=http://127.0.0.1:4318
SIGNOZ_QUERY_ENDPOINT=http://127.0.0.1:8080
SIGNOZ_API_KEY=
SIGNOZ_REGION=local

# Port is intentionally deferred. No Port credentials are used by the current product.
ROBOTWORLD_ENABLE_DEFERRED_PORT=false
ROBOTWORLD_ENABLE_DEFERRED_ISAAC=false

# The pre-canonical parameterized skill agent is retained only for historical
# data inspection. Keep disabled; current control uses typed curriculum tools.
ROBOTWORLD_ENABLE_LEGACY_SKILL_AGENT=false

# Old source-level self-heal endpoints bypass golden/canary governance. Keep
# disabled; current repair actions use /api/scraper-repair-runs.
ROBOTWORLD_ENABLE_LEGACY_SOURCE_REPAIR=false
