# Bootstrap settings. Values saved in the RobotWorld Settings UI take precedence.
HOST=127.0.0.1
PORT=8000

# OpenAI-compatible planner (OpenAI, Ollama, vLLM, llama.cpp)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Bright Data
BRIGHTDATA_API_KEY=
BRIGHTDATA_ACCOUNT_ID=
BRIGHTDATA_SERP_ZONE=serp
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker

# SigNoz ingestion and service-account query API
SIGNOZ_ENDPOINT=https://ingest.us.signoz.cloud:443
SIGNOZ_QUERY_ENDPOINT=
SIGNOZ_INGESTION_KEY=
SIGNOZ_API_KEY=
SIGNOZ_REGION=us

# Port (EU endpoint shown; use https://api.us.port.io for the US region)
PORT_ENDPOINT=https://api.port.io
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=
# Optional short-lived bearer token instead of client credentials
PORT_API_KEY=
